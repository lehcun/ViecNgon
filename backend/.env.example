# Database (SQL Server)
# 1. Nếu dùng SQL Server cài sẵn trên Windows (mặc định khi chạy `docker compose up -d`):
DATABASE_URL="sqlserver://host.docker.internal:1433;database=viecngon;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"
# 2. Nếu chạy SQL Server trong Docker (`docker compose --profile with-db up -d` hoặc trên VPS):
# DATABASE_URL="sqlserver://sqlserver:1433;database=viecngon;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"

# Tự động đồng bộ schema khi khởi động container (chỉ bật lần đầu trên DB trống, sau đó đặt false)
PRISMA_DB_PUSH=false

# Server & Auth
PORT=3001
NODE_ENV=production
JWT_SECRET=CHANGE_ME_STRONG_64_CHAR_RANDOM_SECRET
FRONTEND_URL=https://viecngo.id.vn
CORS_ORIGINS=https://viecngo.id.vn,https://www.viecngo.id.vn
# Phương án B (cùng tên miền gốc qua subdomain): dùng 'lax' + COOKIE_DOMAIN=.domain
# Nếu Frontend & Backend khác tên miền hoàn toàn: đặt 'none' (bắt buộc HTTPS) và bỏ COOKIE_DOMAIN
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=.viecngo.id.vn

# Google OAuth & Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Gemini AI
GEMINI_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_USER=
MAIL_PASS=
MAIL_FROM="ViecNgon <no-reply@viecngo.id.vn>"
